---
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import DonateBanner from "../components/DonateBanner.astro";
import Values from "../components/Values.astro";

import { Image } from "astro:assets";
import About1 from "../assets/about-1.png"
import About2 from "../assets/about-2.png"
---



<MainLayout title="About GlowForWomen">
    <PageHeader>
        About Us
    </PageHeader>


    <!-- About -->
    <section class="section-about py-24">
        <div class="container wrapper">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                <div>
                    <h2 class="heading-secondary mb-8">How it started</h2>
                    <p class="slide-fleft">Global Foundation for Women and Development was founded in 2001 as an Empowerment group for women. We believe women have the right to experience life free from poverty, violence, exclusion and discrimination.
                        <br>
                        By celebrating women’s achievements through initiatives like the "Star and Amazing Women" awards and providing training opportunities, we empower communities to build sustainable futures. </p>
                    <br>
                    <p class="slide-fleft">
                        In 2018, Global Foundation for Women and Development in partnership with other organisations and community groups lunched the "EMPOWERMENT and DEVELOPMENT PROJECT for GIRLS" in Freetown, Sierra Leone and Accra, Ghana.
                        <br>
                        
                    
                    <br>
                        <p class="slide-fleft">Foundation for Women and Development is working with sponsors and other partners to SPONSOR, SUPPORT and PROMOTE the EMPOWERMENT and DEVELOPMENT of the GIRL CHILD. Helping her to reach her full potential!! </p>
                </div>
                <div>
					<!-- <Image src={About1} alt="Aceltrim Group" /> -->
					<Image src={About2} alt="Aceltrim Group" class="mb-8 " />
					<Image src={About1} alt="Aceltrim Group" class="" />
				</div>
            </div>
        </div>
    </section>



    <!-- ============= Values ============= -->
    <Values></Values>
    <!-- End of Values -->











    <!-- This will be the donate banner -->
    <DonateBanner />
    <!-- End of donate banner -->
</MainLayout>







<style lang="scss">

    .section-about {


        img {
            
        }
    }

</style>